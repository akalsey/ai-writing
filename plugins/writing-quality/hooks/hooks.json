{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Artifact|mcp__.+__.*([Cc]reate|[Uu]pdate|[Ww]rite|[Bb]atch|[Dd]raft|[Pp]ublish|[Ee]dit|[Aa]ppend|[Ii]nsert|[Ss]ave).*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
